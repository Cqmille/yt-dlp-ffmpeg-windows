@page "/settings"
@using Microsoft.AspNetCore.Components.Web
@inject ConfigService ConfigService
@inject UpdateService UpdateService
@inject YtDlpService YtDlpService
@inject FFmpegService FFmpegService
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable

<h1 class="mb-4">
    <i class="bi bi-gear me-2"></i>Settings
</h1>

<div class="row">
    <div class="col-lg-8">
        <!-- Tools Status -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-tools me-2"></i>Tools
                </h5>
            </div>
            <div class="card-body">
                <!-- yt-dlp -->
                <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                    <div>
                        <h6 class="mb-1">yt-dlp</h6>
                        @if (ConfigService.IsYtDlpInstalled())
                        {
                            <span class="badge bg-success me-2">Installed</span>
                            <span class="text-muted">Version: @_ytDlpVersion</span>
                            @if (UpdateService.YtDlpUpdateAvailable && !string.IsNullOrEmpty(UpdateService.LatestYtDlpVersion))
                            {
                                <span class="badge bg-warning ms-2">
                                    Update available: @UpdateService.LatestYtDlpVersion
                                </span>
                            }
                        }
                        else
                        {
                            <span class="badge bg-danger">Not installed</span>
                        }
                    </div>
                    <div>
                        @if (ConfigService.IsYtDlpInstalled() && UpdateService.YtDlpUpdateAvailable)
                        {
                            <button class="btn btn-warning" @onclick="UpdateYtDlp" disabled="@_isDownloading">
                                <i class="bi bi-arrow-up-circle me-1"></i>Update
                            </button>
                        }
                        else if (!ConfigService.IsYtDlpInstalled())
                        {
                            <button class="btn btn-primary" @onclick="DownloadYtDlp" disabled="@_isDownloading">
                                <i class="bi bi-download me-1"></i>Download
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-outline-secondary" @onclick="DownloadYtDlp" disabled="@_isDownloading">
                                <i class="bi bi-arrow-clockwise me-1"></i>Reinstall
                            </button>
                        }
                    </div>
                </div>

                <!-- FFmpeg -->
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1">FFmpeg</h6>
                        @if (ConfigService.IsFfmpegInstalled())
                        {
                            <span class="badge bg-success me-2">Installed</span>
                            <span class="text-muted">Version: @_ffmpegVersion</span>
                            @if (UpdateService.FfmpegUpdateAvailable && !string.IsNullOrEmpty(UpdateService.LatestFfmpegVersion))
                            {
                                <span class="badge bg-warning ms-2">
                                    Update available: @UpdateService.LatestFfmpegVersion
                                </span>
                            }
                        }
                        else
                        {
                            <span class="badge bg-danger">Not installed</span>
                        }
                    </div>
                    <div>
                        @if (ConfigService.IsFfmpegInstalled() && UpdateService.FfmpegUpdateAvailable)
                        {
                            <button class="btn btn-warning" @onclick="UpdateFfmpeg" disabled="@_isDownloading">
                                <i class="bi bi-arrow-up-circle me-1"></i>Update
                            </button>
                        }
                        else if (!ConfigService.IsFfmpegInstalled())
                        {
                            <button class="btn btn-primary" @onclick="DownloadFfmpeg" disabled="@_isDownloading">
                                <i class="bi bi-download me-1"></i>Download
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-outline-secondary" @onclick="DownloadFfmpeg" disabled="@_isDownloading">
                                <i class="bi bi-arrow-clockwise me-1"></i>Reinstall
                            </button>
                        }
                    </div>
                </div>

                @if (_isDownloading)
                {
                    <div class="mt-3">
                        <div class="progress mb-2">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: @_downloadProgress%">
                                @_downloadProgress.ToString("F0")%
                            </div>
                        </div>
                        <small class="text-muted">@_downloadStatus</small>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_downloadError))
                {
                    <div class="alert alert-danger mt-3 mb-0">
                        <i class="bi bi-x-circle me-2"></i>@_downloadError
                    </div>
                }
            </div>
        </div>

        <!-- Download Settings -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-download me-2"></i>Download Settings
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Output Directory</label>
                    <input type="text" class="form-control" @bind="_outputDirectory" />
                    <small class="text-muted">Default location for downloaded files</small>
                </div>
                <div class="mb-3">
                    <label class="form-label">Default Format</label>
                    <select class="form-select" @bind="_defaultFormat">
                        <option value="bestvideo+bestaudio/best">Best Quality</option>
                        <option value="bestvideo[height<=1080]+bestaudio/best[height<=1080]">1080p Max</option>
                        <option value="bestvideo[height<=720]+bestaudio/best[height<=720]">720p Max</option>
                        <option value="bestvideo[height<=480]+bestaudio/best[height<=480]">480p Max</option>
                        <option value="bestaudio">Audio Only</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Max Concurrent Downloads</label>
                    <select class="form-select" @bind="_maxConcurrent">
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                    </select>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" @bind="_embedSubtitles" id="defSubs" />
                    <label class="form-check-label" for="defSubs">
                        Embed subtitles by default
                    </label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" @bind="_embedMetadata" id="defMeta" />
                    <label class="form-check-label" for="defMeta">
                        Embed metadata by default
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" @bind="_enableNotifications" id="notif" />
                    <label class="form-check-label" for="notif">
                        Enable notification sound on completion
                    </label>
                </div>
            </div>
            <div class="card-footer">
                <button class="btn btn-primary" @onclick="SaveSettings">
                    <i class="bi bi-check-lg me-1"></i>Save Settings
                </button>
            </div>
        </div>

        <!-- About -->
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-info-circle me-2"></i>About
                </h5>
            </div>
            <div class="card-body">
                <h4>MediaGrabber v1.0.0</h4>
                <p class="text-muted">
                    A powerful media downloader and processor powered by yt-dlp and FFmpeg.
                </p>
                <div class="mb-3">
                    <strong>Paths:</strong>
                    <ul class="mb-0 mt-1">
                        <li>Application: <code>@ConfigService.AppDirectory</code></li>
                        <li>Tools: <code>@ConfigService.ToolsDirectory</code></li>
                        <li>Config: <code>@Path.Combine(ConfigService.AppDirectory, "config.json")</code></li>
                    </ul>
                </div>
                <div>
                    <a href="https://github.com/yt-dlp/yt-dlp" target="_blank" class="btn btn-sm btn-outline-secondary me-2">
                        <i class="bi bi-github me-1"></i>yt-dlp
                    </a>
                    <a href="https://ffmpeg.org" target="_blank" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-box-arrow-up-right me-1"></i>FFmpeg
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Quick Actions -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-lightning me-2"></i>Quick Actions
                </h5>
            </div>
            <div class="list-group list-group-flush">
                <button class="list-group-item list-group-item-action" @onclick="CheckForUpdates" disabled="@UpdateService.IsChecking">
                    @if (UpdateService.IsChecking)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-repeat me-2"></i>
                    }
                    Check for Updates
                </button>
                <button class="list-group-item list-group-item-action" @onclick="OpenOutputFolder">
                    <i class="bi bi-folder2-open me-2"></i>Open Output Folder
                </button>
                <button class="list-group-item list-group-item-action" @onclick="OpenToolsFolder">
                    <i class="bi bi-folder-symlink me-2"></i>Open Tools Folder
                </button>
            </div>
        </div>

        <!-- Storage Info -->
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-hdd me-2"></i>Storage
                </h5>
            </div>
            <div class="card-body">
                @if (_outputDirInfo != null)
                {
                    <div class="mb-2">
                        <strong>Output Directory</strong>
                        <div class="text-muted small">@_outputDirInfo</div>
                    </div>
                }
                @if (_toolsDirInfo != null)
                {
                    <div>
                        <strong>Tools Directory</strong>
                        <div class="text-muted small">@_toolsDirInfo</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string _ytDlpVersion = "Loading...";
    private string _ffmpegVersion = "Loading...";

    private string _outputDirectory = "";
    private string _defaultFormat = "bestvideo+bestaudio/best";
    private int _maxConcurrent = 2;
    private bool _embedSubtitles = true;
    private bool _embedMetadata = true;
    private bool _enableNotifications = true;

    private bool _isDownloading;
    private double _downloadProgress;
    private string? _downloadStatus;
    private string? _downloadError;

    private string? _outputDirInfo;
    private string? _toolsDirInfo;

    protected override async Task OnInitializedAsync()
    {
        LoadSettings();

        UpdateService.OnProgressChanged += OnDownloadProgress;
        UpdateService.OnStatusChanged += OnStatusChanged;

        await LoadVersionsAsync();
        await LoadStorageInfoAsync();
    }

    public void Dispose()
    {
        UpdateService.OnProgressChanged -= OnDownloadProgress;
        UpdateService.OnStatusChanged -= OnStatusChanged;
    }

    private void LoadSettings()
    {
        var config = ConfigService.Config;
        _outputDirectory = config.OutputDirectory;
        _defaultFormat = config.DefaultVideoFormat;
        _maxConcurrent = config.MaxConcurrentDownloads;
        _embedSubtitles = config.EmbedSubtitles;
        _embedMetadata = config.EmbedMetadata;
        _enableNotifications = config.EnableNotificationSound;
    }

    private async Task LoadVersionsAsync()
    {
        if (ConfigService.IsYtDlpInstalled())
        {
            _ytDlpVersion = await YtDlpService.GetVersionAsync();
        }
        else
        {
            _ytDlpVersion = "Not installed";
        }

        if (ConfigService.IsFfmpegInstalled())
        {
            _ffmpegVersion = await FFmpegService.GetVersionAsync();
        }
        else
        {
            _ffmpegVersion = "Not installed";
        }
    }

    private Task LoadStorageInfoAsync()
    {
        try
        {
            if (Directory.Exists(_outputDirectory))
            {
                var files = Directory.GetFiles(_outputDirectory, "*", SearchOption.AllDirectories);
                var totalSize = files.Sum(f => new FileInfo(f).Length);
                _outputDirInfo = $"{files.Length} files, {FormatBytes(totalSize)}";
            }
            else
            {
                _outputDirInfo = "Directory not found";
            }
        }
        catch
        {
            _outputDirInfo = "Unable to read";
        }

        try
        {
            if (Directory.Exists(ConfigService.ToolsDirectory))
            {
                var files = Directory.GetFiles(ConfigService.ToolsDirectory);
                var totalSize = files.Sum(f => new FileInfo(f).Length);
                _toolsDirInfo = $"{files.Length} files, {FormatBytes(totalSize)}";
            }
            else
            {
                _toolsDirInfo = "Directory not found";
            }
        }
        catch
        {
            _toolsDirInfo = "Unable to read";
        }

        return Task.CompletedTask;
    }

    private void SaveSettings()
    {
        ConfigService.UpdateConfig(c =>
        {
            c.OutputDirectory = _outputDirectory;
            c.DefaultVideoFormat = _defaultFormat;
            c.MaxConcurrentDownloads = _maxConcurrent;
            c.EmbedSubtitles = _embedSubtitles;
            c.EmbedMetadata = _embedMetadata;
            c.EnableNotificationSound = _enableNotifications;
        });

        // Ensure output directory exists
        if (!Directory.Exists(_outputDirectory))
        {
            try
            {
                Directory.CreateDirectory(_outputDirectory);
            }
            catch { }
        }
    }

    private async Task DownloadYtDlp()
    {
        _isDownloading = true;
        _downloadError = null;
        _downloadProgress = 0;

        try
        {
            await UpdateService.DownloadYtDlpAsync();
            _ytDlpVersion = await YtDlpService.GetVersionAsync();
        }
        catch (Exception ex)
        {
            _downloadError = ex.Message;
        }
        finally
        {
            _isDownloading = false;
            await LoadStorageInfoAsync();
        }
    }

    private async Task UpdateYtDlp() => await DownloadYtDlp();

    private async Task DownloadFfmpeg()
    {
        _isDownloading = true;
        _downloadError = null;
        _downloadProgress = 0;

        try
        {
            await UpdateService.DownloadFfmpegAsync();
            _ffmpegVersion = await FFmpegService.GetVersionAsync();
        }
        catch (Exception ex)
        {
            _downloadError = ex.Message;
        }
        finally
        {
            _isDownloading = false;
            await LoadStorageInfoAsync();
        }
    }

    private async Task UpdateFfmpeg() => await DownloadFfmpeg();

    private async Task CheckForUpdates()
    {
        await UpdateService.CheckForUpdatesAsync();
        StateHasChanged();
    }

    private void OnDownloadProgress(double progress)
    {
        _downloadProgress = progress;
        InvokeAsync(StateHasChanged);
    }

    private void OnStatusChanged(string status)
    {
        _downloadStatus = status;
        InvokeAsync(StateHasChanged);
    }

    private void OpenOutputFolder()
    {
        try
        {
            if (Directory.Exists(_outputDirectory))
            {
                System.Diagnostics.Process.Start("explorer.exe", _outputDirectory);
            }
        }
        catch { }
    }

    private void OpenToolsFolder()
    {
        try
        {
            if (Directory.Exists(ConfigService.ToolsDirectory))
            {
                System.Diagnostics.Process.Start("explorer.exe", ConfigService.ToolsDirectory);
            }
        }
        catch { }
    }

    private static string FormatBytes(long bytes)
    {
        string[] sizes = ["B", "KB", "MB", "GB", "TB"];
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
